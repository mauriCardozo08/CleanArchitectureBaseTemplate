{
  "$schema": "http://json.schemastore.org/template",
  "author": "Mauricio Cardozo",
  "classifications": [ "Web", "API", "Clean Architecture" ],
  "identity": "CleanArchitecture.Backend.Template",
  "name": "Clean Architecture Backend (.NET 10)",
  "shortName": "cleanarch",
  "description": "Monolithic .NET 10 backend following Clean Architecture (API, Application, Domain, Infrastructure, Contracts).",
  "tags": { "language": "C#", "type": "solution" },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        { "exclude": [ ".git/**", ".template.config/**", "README.md", "**/bin/**", "**/obj/**" ] }
      ]
    }
  ],
  "symbols": {
    "httpPort": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "5100",
      "replaces": "5100",
      "description": "HTTP port for launchSettings."
    },
    "httpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "7100",
      "replaces": "7100",
      "description": "HTTPS port for launchSettings."
    }
  }
}
